# ==============================================================================
# Twins Bot Client Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`: cp .env.client .env (or copy .env.client .env)
# 2. Fill in your account credentials and connection details below.
# 3. Install dependencies: npm install
# 4. Start bot: npm run bot1 (or npm run bot2)
# ==============================================================================

# --- Minecraft Account Credentials ---
USERNAME=YourMinecraftUsernameOrEmail
PASSWORD=YourMinecraftPassword

# --- Minecraft Server Connection ---
MINECRAFT_HOST=5.83.140.251
MINECRAFT_PORT=25809

# --- WebSocket Hub Connection ---
# IP address or domain of the Hub server
HUB_HOST=localhost
HUB_PORT=8089
BOT_TOKEN=your_secret_bot_token_here

# --- Bot & Main Account Settings ---
MAIN_ACCOUNT=AlexZTI_
TWINKS=AlexZTI_Twin,AlexZTI_Twin1
